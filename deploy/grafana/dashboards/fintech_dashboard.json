{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "title": "Throughput de Transferências (TPS por Status/Razão)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status, reason) (rate(fintech_transfers_total[1m]))",
          "legendFormat": "{{status}} ({{reason}})"
        }
      ]
    },
    {
      "title": "Latência de Transação (Percentis p95 & p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(fintech_transfer_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(fintech_transfer_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Volume Contábil no Livro-Razão (Double-Entry)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (entry_type) (rate(fintech_ledger_entries_total[1m]))",
          "legendFormat": "Entradas {{entry_type}}"
        }
      ]
    },
    {
      "title": "Locks Distribuídos Concorrentes no Redis",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "fintech_active_distributed_locks",
          "legendFormat": "Locks Ativos"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "5s",
